{
  "name": "Follow",
  "type": "object",
  "properties": {
    "follower_id": {
      "type": "string"
    },
    "following_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted"
      ],
      "default": "pending"
    }
  },
